                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ( Block editor 1/3 ____________________________________________ 10/11/26 BNE )                                                  vocabulary editor  also editor definitions                                      \ vocabulary for the editor                     _udata  variable scr                                                            \ block being edited or listed                  variable listcnt                                                                