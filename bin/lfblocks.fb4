-- u )      -if negate then ;                                   \ absolute value                                : dabs      ( d -- ud )     -if dnegate then ;                                  \ double-cell absolute value                    : +!        ( n a -- )      a! @a + !a ;                                        \ add n to cell at a                            : *         ( n1 n2 -- n3 ) um* drop ;                                          \ multiply                                      : s>d       ( n -- d )      dup 0< ;                                            \ convert single to double                      : min       ( n1 n2 -- n3 ) 2dup - -if 2drop exit then drop nip ;               \ n3 is the lesser of n1 and n2                 : max       ( n1 n2 -- n3 ) 2dup - -if drop nip exit then 2drop ;               \ n3 is the greater of n1 and n2                : rot       ( x1 x2 x3 -- x2 x3 x1 ) b! swap b swap ;                           \ rotate third item to top of stack             : u<=       ( u1 u2 -- flag ) swap - drop cy ;                                  \ unsigned less than or equal                   -->                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             