                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ( Control structures __________________________________________ 10/10/26 BNE )                                                  hex                                                                                                                             : _again    ( a inst -- )   >r iaddr  chere iaddr inv + 1FF and r> + ,inst ;    \ compile a backward control branch             : then      ( C: a -- )     chere iaddr  over iaddr inv +  swap                 \ resolve a forward branch                                                  a! 1FF and @a + !a ; immediate                                                                      : -if       ( C: -- a ) ( n -- n ) chere _pbran ,inst ; immediate               \ if n is negative, run up to then; keeps n     : if        ( C: -- a ) ( flag -- ) chere _0bran ,inst ; immediate              \ if flag is nonzero, run up to else or then    : ahead     ( C: -- a )     chere _bran ,inst ; immediate                       \ compile an unconditional forward branch       : else      ( C: a1 -- a2 ) postpone ahead  swap  postpone then ; immediate     \ start the part that runs when if fails        : begin     ( C: -- a )     chere ; immediate                                   \ start a loop                                  : again     ( C: a -- )     _bran _again ; immed