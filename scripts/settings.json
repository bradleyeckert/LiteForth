{
    // Windows Terminal shortcuts for LiteForth development.
    // Merge the "actions" and "keybindings" entries below into your own
    // Windows Terminal settings.json (Settings > Open JSON file).
    // Edit the F10 path to point at your own LiteForth checkout.
    "actions":
    [
        {
            "command":
            { // F9 = boot up LiteForth
                "action": "sendInput",
                "input": "Get-Content ..\\scripts\\go.f | .\\lf.exe -o 3\r"
            },
            "id": "User.sendInput.myF9key"
        },
        {
            "command":
            { // F10 = go to the LiteForth bin directory
                "action": "sendInput",
                "input": "cd C:\\path\\to\\LiteForth\\bin\r"
            },
            "id": "User.sendInput.myF10key"
        },
        {
            "command":
            { // F12 = run regression tests on LiteForth
                "action": "sendInput",
                "input": "Get-Content ..\\scripts\\regression.f | .\\lf.exe -o 7\r"
            },
            "id": "User.sendInput.myF12key"
        }
    ],
    "keybindings":
    [
        {
            "id": "User.sendInput.myF9key",
            "keys": "f9"
        },
        {
            "id": "User.sendInput.myF10key",
            "keys": "f10"
        },
        {
            "id": "User.sendInput.myF12key",
            "keys": "f12"
        }
    ]
}
