{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            { // F9 = boot up LiteForth
                "action": "sendInput",
                "input": "Get-Content ..\\scripts\\go.f | .\\lf.exe -o 3\r"
            },
            "id": "User.sendInput.myF9key"
        },
        {
            "command": 
            { // F10 = home directory
                "action": "sendInput",
                "input": "cd C:\\Users\\User\\Documents\\GitHub\\LiteForth\\bin\r"
            },
            "id": "User.sendInput.myF10key"
        },
        {
            "command": 
            { // F12 = run regression tests on LiteForth
                "action": "sendInput",
                "input": "Get-Content ..\\scripts\\primitives.f | .\\lf.exe -o 31\r"
            },
            "id": "User.sendInput.myF12key"
        }
    ],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
    "keybindings": 
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "User.sendInput.myF12key",
            "keys": "f12"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        },
        {
            "id": "User.sendInput.myF9key",
            "keys": "f9"
        },
        {
            "id": "User.sendInput.myF10key",
            "keys": "f10"
        }
    ],
    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],
