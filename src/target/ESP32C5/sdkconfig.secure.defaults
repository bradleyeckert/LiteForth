# Production security overlay for the ESP32-C5 release build.
#
# Apply ON TOP of sdkconfig.defaults for a release candidate, e.g.:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.secure.defaults" build
# and gate the result with scripts/ESP32C5/seccheck.py (profile production).
# This is the baseline from doc/ESP32C5/admin/security-plan.md section 7.1.
#
# NOTE: enabling Secure Boot / flash encryption here configures the build; the
# actual eFuse burns happen at flash/provisioning time and are IRREVERSIBLE.
# Do NOT apply this to a development board you still want to reflash over UART.
# Confirm the C5 download-mode and signature-scheme choices against the TRM
# before the first burn.

# --- Secure Boot v2 (choose RSA or ECDSA; ECDSA shown) ---
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_V2_ECDSA_ENABLED=y
# CONFIG_SECURE_BOOT_V2_RSA_ENABLED is not set

# --- Flash encryption, Release mode ---
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT is not set
CONFIG_SECURE_FLASH_CHECK_ENC_EN_IN_APP=y

# --- Close the ROM serial download back door (updates via OTA only) ---
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
# (Alternatively CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y for a restricted
#  encrypted recovery path; do not leave download mode fully open.)

# --- OTA rollback + anti-rollback (downgrade protection) ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y

# --- No insecure escapes (must stay unset) ---
# CONFIG_SECURE_BOOT_ALLOW_JTAG is not set
# CONFIG_SECURE_BOOT_ALLOW_ROM_BASIC is not set
# CONFIG_SECURE_BOOT_ALLOW_SHORT_APP_PARTITION is not set
# CONFIG_SECURE_BOOT_ALLOW_UNUSED_DIGEST_SLOTS is not set
# CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC is not set
# CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_DEC is not set
# CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_CACHE is not set

# --- Software hardening ---
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_BOOTLOADER_WDT_ENABLE=y
